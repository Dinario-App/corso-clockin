{
  "expo": {
    "name": "Corso",
    "slug": "corso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/pari/2-pari-app-icon-1024.png",
    "scheme": "corso",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/brand/pari/2-pari-app-icon-1024.png",
      "bundleIdentifier": "app.corso.wallet",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Corso uses Face ID to unlock the app.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#060606",
        "backgroundImage": "./assets/brand/pari-chrome/pari-adaptive-background.png",
        "foregroundImage": "./assets/brand/pari-chrome/pari-adaptive-foreground.png",
        "monochromeImage": "./assets/brand/pari-chrome/pari-adaptive-foreground.png"
      },
      "package": "app.corso.wallet",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Corso uses Face ID to unlock the app."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Corso uses the camera to scan a Solana address and for MoonPay identity checks.",
          "recordAudioAndroid": false
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-local-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/pari-chrome/pari-splash.png",
          "backgroundColor": "#060606",
          "imageWidth": 288,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/InterVariable.ttf",
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-Medium.ttf",
            "./assets/fonts/Inter-SemiBold.ttf",
            "./assets/fonts/Inter-Bold.ttf",
            "./assets/fonts/Inter-Black.ttf",
            "./assets/fonts/SpaceMono-Regular.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Inter-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Inter-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Inter-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "InterVariable",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/InterVariable.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Inter-Black",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter-Black.ttf",
                    "weight": 900
                  }
                ]
              },
              {
                "fontFamily": "SpaceMono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/SpaceMono-Regular.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/InterVariable.ttf",
              "./assets/fonts/Inter-Regular.ttf",
              "./assets/fonts/Inter-Medium.ttf",
              "./assets/fonts/Inter-SemiBold.ttf",
              "./assets/fonts/Inter-Bold.ttf",
              "./assets/fonts/Inter-Black.ttf",
              "./assets/fonts/SpaceMono-Regular.ttf"
            ]
          }
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "defaultChannel": "price-alerts",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "flavor": "play",
      "router": {},
      "eas": {
        "projectId": "fda86733-17f5-4b79-8440-ebd4ab2b288e"
      }
    },
    "owner": "dinario",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fda86733-17f5-4b79-8440-ebd4ab2b288e",
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    }
  }
}
